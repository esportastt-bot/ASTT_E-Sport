rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }

    function isCaptain() {
      return isLoggedIn() && (
        request.auth.token.is_captain == true ||
        request.auth.token.role == 'CAPTAIN'
      );
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function isPollOpen(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'OPEN';
    }

    // ── Members ──────────────────────────────────────────────────────────────
    match /members/{discordId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(discordId) || isCaptain();
    }

    // ── Polls ─────────────────────────────────────────────────────────────────
    match /polls/{pollId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isCaptain();

      // Slots : lecture pour tous les membres connectés, écriture uniquement capitaine
      match /slots/{slotId} {
        allow read: if isLoggedIn();
        allow write: if isCaptain();
      }

      // Responses : chaque membre écrit/modifie UNIQUEMENT ses propres réponses
      // et uniquement si le sondage est ouvert
      match /responses/{userId} {
        allow read: if isLoggedIn();
        allow create, update: if isOwner(userId) && isPollOpen(pollId);
        allow delete: if isCaptain();
      }

      // Members du sondage : lecture tous, écriture par le membre concerné ou capitaine
      match /members/{userId} {
        allow read: if isLoggedIn();
        allow write: if isOwner(userId) || isCaptain();
      }
    }

    // ── Usual Availabilities ─────────────────────────────────────────────────
    match /usual_availabilities/{discordId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(discordId);
    }

    // ── Exceptions ───────────────────────────────────────────────────────────
    match /exceptions/{exceptionId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.discord_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && resource.data.discord_id == request.auth.uid;
    }

    // ── Notification Events (lecture capitaine, écriture Worker/Admin) ───────
    match /notification_events/{eventId} {
      allow read: if isCaptain();
      allow write: if false; // Uniquement via Service Account (Cloudflare Worker)
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isCaptain();
    }
  }
}
